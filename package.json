{
  "name": "amlyrics",
  "version": "1.2.0",
  "description": "AMLyrics — Windows 桌面歌词播放器（系统 SMTC + AMLL 逐字歌词）",
  "main": "electron/main.cjs",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build:web": "node build-web.mjs",
    "build:helper": "cd smtc-helper/SmtcBridge && dotnet publish -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o ../publish",
    "build": "npm run build:web && npm run build:helper",
    "start": "npm run build:web && electron .",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.5.2",
    "@applemusic-like-lyrics/lyric": "^1.0.2",
    "@applemusic-like-lyrics/react": "^0.5.2",
    "@applemusic-like-lyrics/ttml": "^1.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.amlyrics.windows",
    "productName": "AMLyrics",
    "artifactName": "AMLyrics-Win-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "electron/**/*",
      "renderer/index.html",
      "renderer/amll.bundle.js",
      "renderer/amll.bundle.css",
      "renderer/*.woff2",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "smtc-helper/publish",
        "to": "smtc-helper",
        "filter": [
          "**/*",
          "!*.pdb"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "AMLyrics-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AMLyrics",
      "deleteAppDataOnUninstall": false
    }
  }
}
